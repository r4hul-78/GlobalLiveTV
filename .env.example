# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///instance/iptv.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# Ingestion Configuration
PLAYLIST_INDEX_URL=https://iptv-org.github.io/iptv/index.m3u
PLAYLIST_COUNTRY_URL=https://iptv-org.github.io/iptv/index.country.m3u
PLAYLIST_CATEGORY_URL=https://iptv-org.github.io/iptv/index.category.m3u
PLAYLIST_LANGUAGE_URL=https://iptv-org.github.io/iptv/index.language.m3u

# Health Checker Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTH_CHECK_CONCURRENCY=5
HEALTH_CHECK_MAX_FAILURES=3

# Refresh & Performance Configuration
FILTER_CACHE_TTL_SECONDS=300
REFRESH_LOCK_TIMEOUT_SECONDS=3600
REFRESH_BATCH_SIZE=50

